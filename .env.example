# ==========================================================
# MIRACLE SPA - EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo como .env y edita tus valores locales.
# ==========================================================

# Configuración de Base de Datos (MySQL / MariaDB en XAMPP o Producción)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miraclespa_db
DB_USER=root
DB_PASS=

# Autenticación con JWT (JSON Web Tokens - RFC 7519)
JWT_SECRET=tu_clave_secreta_jwt_personalizada_y_segura_aqui_2026
JWT_EXPIRATION_SECONDS=86400

# Configuración de Correo Electrónico (Opcional - por defecto 'simulated')
MAIL_DRIVER=simulated
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=citas@miraclespa.com
SMTP_FROM_NAME="Miracle Spa Sanctuary"
